# Configuración de ESTA célula. Copiar a .env y rellenar en el PC del cliente.
IMAGE=cobot-base          # o el registry: ghcr.io/<tu-empresa>/cobot-base
VERSION=0.1.0             # versión entregada; para volver atrás basta con cambiarla
ROBOT_IP=192.168.1.10     # IP del controlador UR de la célula
UR_TYPE=ur5e              # ur3e, ur5e, ur10e, ur16e...
ROS_DOMAIN_ID=0
# Calibración de ESTE robot. "nominal" = valores genéricos del modelo (vale para URSim, no para producción).
# Tras `docker compose run --rm calibrate`, poner: KINEMATICS_FILE=/calibration/robot_calibration.yaml
KINEMATICS_FILE=nominal
