# Copia a .env (scripts/dev.sh lo hace solo). docker compose y el Dev Container lo leen automáticamente.
USER_UID=1000          # id -u   -> el usuario del contenedor es "tú"
USER_GID=1000          # id -g
ROS_DOMAIN_ID=0        # igual en Isaac Sim, contenedores y ROS del host para que se vean
URSIM_MODEL=UR5
URSIM_TAG=latest       # en proyectos de cliente, fija una versión concreta
