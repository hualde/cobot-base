<?xml version="1.0"?>
<!-- UR (descripción oficial de ur_description) + Intel RealSense D455 en la muñeca
     (modelo oficial de realsense2_description: malla, medidas y marcos iguales que los del driver realsense2_camera).
     Sin nada específico de simulador: sirve para robot_state_publisher, para Isaac Sim (que usa el asset
     /Isaac/Sensors/RealSense/D455/rsd455.usd con la misma geometría) y para el robot real. -->
<robot xmlns:xacro="http://wiki.ros.org/xacro" name="$(arg name)">
  <xacro:include filename="$(find ur_description)/urdf/ur.urdf.xacro"/>
  <xacro:include filename="$(find realsense2_description)/urdf/_d455.urdf.xacro"/>

  <xacro:arg name="camera_name" default="wrist_camera"/>
  <!-- true: este URDF publica los marcos ópticos (color, profundidad, IR...) con los valores nominales (simulación).
       false: con la cámara real, porque el driver realsense2_camera ya publica sus extrínsecos calibrados. -->
  <xacro:arg name="camera_nominal_extrinsics" default="true"/>
  <xacro:arg name="tf_prefix" default=""/>
  <xacro:property name="prefix" value="$(arg tf_prefix)"/>

  <!-- Montaje lateral: la base de la cámara (rosca de trípode, wrist_camera_bottom_screw_frame) apoyada en un
       soporte a 5,2 cm del eje de la brida, por el lado -Y de tool0 (la muñeca del UR5e llega a 4,4 cm).
       La cámara mira a lo largo de +Z de tool0 (hacia fuera de la brida) con el lado largo según X de tool0,
       así la brida queda libre para una herramienta.
       ¡Si cambias estos números, cambia también MOUNT_XYZ / MOUNT_RPY en isaac/ur_inspection_cell.py! -->
  <xacro:sensor_d455 parent="${prefix}tool0" name="$(arg camera_name)"
                     use_nominal_extrinsics="$(arg camera_nominal_extrinsics)">
    <origin xyz="0 -0.052 -0.01" rpy="${pi/2} ${-pi/2} 0"/>
  </xacro:sensor_d455>
</robot>
